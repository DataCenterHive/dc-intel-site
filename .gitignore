# Large data files that should NOT be committed to git
# These files are generated by data pipelines and served via API

# Large CSV data files (over 100MB limit)
docs/masters/DC_Upcoming_Combined.csv
docs/masters/*_Combined.csv

# Large JSON data files (over 100MB - served from Cloudflare R2)
# Note: upcoming_dcs_enriched.json is now small (<1MB) and committed to git
docs/upcoming_dcs_geocoded.json
docs/daily_articles.json

# General patterns for large data files
*.csv
!knowledge/**/*.csv

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
.cache/
docs/masters/DC_Upcoming_Combined.csv
masters/DC_Upcoming_Combined.csv
DC_Upcoming_Combined.csv
